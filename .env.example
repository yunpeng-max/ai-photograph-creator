# ============================================
# AI Photograph Creator — 环境配置
# 本地: 直接使用 start.sh
# 部署: 复制为 .env 并填入真实值
# ============================================

# JWT 密钥 — 部署时务必改为 32+ 位随机字符串！
SECRET_KEY=your-secret-key-here

# DashScope API Key (阿里云通义万象)
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# CORS 允许的域名 — 部署时改为你的公网域名或 IP
# 多个用逗号分隔，例如: http://mydomain.com,https://mydomain.com
ALLOWED_ORIGINS=http://localhost,http://localhost:80
